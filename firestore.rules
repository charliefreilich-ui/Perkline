rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Check if user is admin.
    function isAdmin() {
      let admins = ['charlie.freilich@gmail.com'];
      return isSignedIn() && 
             "email" in request.auth.token && 
             request.auth.token.email.lower() in admins;
    }

    // Check if user is a specific business owner
    function isBusinessOwner(businessId) {
      // Rocknasium Owner
      return isSignedIn() && 
             "email" in request.auth.token && 
             request.auth.token.email.lower() == 'clfreilich@ucdavis.edu' &&
             businessId == 'rocknasium';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['email']) &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidDeal(data) {
      return data.keys().hasAll(['businessId', 'title', 'discount']) &&
             data.businessId is string &&
             data.title is string && data.title.size() <= 100 &&
             data.discount is string && data.discount.size() <= 50;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && (
        isAdmin() || (
          // Regular users can only change non-admin fields
          !incoming().diff(existing()).affectedKeys().hasAny(['isAdmin'])
        )
      );

      // User activity (subcollection)
      match /activity/{activityId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Businesses
    match /businesses/{businessId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isBusinessOwner(businessId) || (
        // Allow incrementing revenue and savings metrics
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['totalFeaturedRevenue', 'totalSavingsProvided', 'usageCount'])
      );
    }

    // Deals
    match /deals/{dealId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && isBusinessOwner(incoming().businessId));
      allow delete: if isAdmin() || isBusinessOwner(existing().businessId);
      allow update: if isAdmin() || isBusinessOwner(existing().businessId) || (
        // Allow incrementing usage counts
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount', 'featuredScanCount'])
      );
    }
    
    // Connection test path
    match /test/connection {
      allow read: if true;
    }
  }
}
